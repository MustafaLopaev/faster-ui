{
  "name": "@mlopaev/faster-ui",
  "version": "0.1.0",
  "description": "Accessible, token-driven React component library — Button, Input and Dialog built on the TapTap Design System.",
  "keywords": [
    "react",
    "component-library",
    "design-system",
    "design-tokens",
    "tailwindcss",
    "accessibility",
    "wcag",
    "a11y",
    "typescript",
    "button",
    "input",
    "dialog",
    "headless-friendly",
    "ui-components"
  ],
  "license": "MIT",
  "author": "Mustafa Lopaev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MustafaLopaev/faster-ui.git"
  },
  "homepage": "https://github.com/MustafaLopaev/faster-ui#readme",
  "bugs": {
    "url": "https://github.com/MustafaLopaev/faster-ui/issues"
  },
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "packageManager": "npm@10.9.7",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./a11y.css": "./dist/a11y.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/postbuild.mjs",
    "lint": "oxlint --max-warnings=0",
    "lint:workflows": "node scripts/check-workflows.mjs",
    "lint:tokens": "node scripts/token-audit.mjs",
    "typecheck": "tsc -b",
    "test": "jest --selectProjects unit",
    "test:watch": "jest --selectProjects unit --watch",
    "test:coverage": "jest --selectProjects unit --coverage",
    "test:ssr": "jest --selectProjects ssr-dom ssr-node",
    "test:consumers": "node scripts/consumer-smoke.mjs",
    "test:a11y": "FUI_SUITE=a11y cypress run --component",
    "cy:ct": "cypress run --component",
    "cy:open": "cypress open --component",
    "api:report": "node scripts/api-report.mjs --local",
    "api:check": "node scripts/api-report.mjs",
    "visual:capture": "node scripts/visual-capture.mjs",
    "visual:compare": "node scripts/visual-compare.mjs",
    "visual:accept": "node scripts/visual-accept.mjs",
    "coverage:gate": "node scripts/coverage-gate.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.119.0",
    "@arethetypeswrong/cli": "^0.18.5",
    "@microsoft/api-extractor": "^7.58.12",
    "@storybook/addon-a11y": "^10.5.9",
    "@storybook/addon-docs": "^10.5.9",
    "@storybook/react-vite": "^10.5.9",
    "@swc/core": "^1.16.0",
    "@swc/jest": "^0.2.39",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "axe-core": "^4.13.0",
    "cypress": "^15.21.0",
    "cypress-axe": "^1.7.0",
    "cypress-real-events": "^1.15.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "oxlint": "^1.75.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "publint": "^0.3.24",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "storybook": "^10.5.9",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.2.0",
    "vite-plugin-dts": "^5.0.3"
  }
}
